{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Dark (Photocopier)",
  "description": "Dark style variation. Photocopier-black surface, printer-ivory ink, selective-yellow shadows. AA contrast preserved across all post-type accents. WordPress site editor users can choose this as their default; the per-visitor JS toggle will still override at runtime.",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "primary",
          "name": "Russian Violet",
          "color": "#241c4a"
        },
        {
          "slug": "primary-accent",
          "name": "Periwinkle",
          "color": "#bcb5e3"
        },
        {
          "slug": "primary-alt",
          "name": "Blue Green",
          "color": "#219ebc"
        },
        {
          "slug": "primary-alt-accent",
          "name": "Prussian Blue",
          "color": "#023047"
        },
        {
          "slug": "main",
          "name": "Printer Ivory (Text)",
          "color": "#fbfaf5"
        },
        {
          "slug": "main-accent",
          "name": "Photocopier Black",
          "color": "#1a1714"
        },
        {
          "slug": "base",
          "name": "Photocopier Black (Surface)",
          "color": "#1a1714"
        },
        {
          "slug": "secondary",
          "name": "Glaucous",
          "color": "#647baf"
        },
        {
          "slug": "tertiary",
          "name": "Night Elevated",
          "color": "#251f1c"
        },
        {
          "slug": "border-light",
          "name": "Night Elevated (Border)",
          "color": "#251f1c"
        },
        {
          "slug": "border-dark",
          "name": "Periwinkle (Border)",
          "color": "#bcb5e3"
        },
        {
          "slug": "selective-yellow",
          "name": "Selective Yellow",
          "color": "#ffb703"
        },
        {
          "slug": "ut-orange",
          "name": "UT Orange",
          "color": "#fb8500"
        },
        {
          "slug": "cerulean",
          "name": "Cerulean",
          "color": "#126782"
        },
        {
          "slug": "sky-blue",
          "name": "Sky Blue",
          "color": "#8ecae6"
        },
        {
          "slug": "night-elevated",
          "name": "Night Elevated",
          "color": "#251f1c"
        }
      ]
    },
    "shadow": {
      "presets": [
        {
          "slug": "hard",
          "name": "Hard Shadow",
          "shadow": "4px 4px 0 #ffb703"
        },
        {
          "slug": "hard-2",
          "name": "Hard Shadow Large",
          "shadow": "6px 6px 0 #ffb703"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#1a1714",
      "text": "#fbfaf5"
    },
    "elements": {
      "heading": {
        "color": {
          "text": "#fbfaf5"
        }
      },
      "link": {
        "color": {
          "text": "#8ecae6"
        },
        ":hover": {
          "color": {
            "text": "#ffb703"
          }
        }
      },
      "button": {
        "color": {
          "background": "#ffb703",
          "text": "#241c4a"
        },
        ":hover": {
          "color": {
            "background": "#8ecae6",
            "text": "#241c4a"
          }
        }
      },
      "caption": {
        "color": {
          "text": "#bcb5e3"
        }
      }
    },
    "blocks": {
      "core/quote": {
        "border": {
          "left": {
            "color": "#ffb703",
            "style": "solid",
            "width": "4px"
          }
        }
      },
      "core/code": {
        "color": {
          "background": "#2a2520",
          "text": "#bcb5e3"
        }
      },
      "core/separator": {
        "color": {
          "background": "#3a342f"
        }
      }
    }
  }
}

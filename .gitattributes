# export-ignore keeps development files out of GitHub's source zips and
# git archive: tests, docs, archived templates and verification screenshots.
# tools/ and package.json stay in: courtneyr.dev's sync-theme.sh builds from
# git archive and runs tools/minify-css.mjs, which reads the esbuild pin from
# package.json.
/.claude export-ignore
/storybook export-ignore
/.github export-ignore
/tests export-ignore
/docs export-ignore
/_archive export-ignore
/_handoffs export-ignore
/CLAUDE.md export-ignore
/CHANGELOG.md export-ignore
/composer.json export-ignore
/composer.lock export-ignore
/package-lock.json export-ignore
/phpcs.xml.dist export-ignore
/stylelint.config.mjs export-ignore
/callouts-test-post.png export-ignore
/v0.*.png export-ignore
.gitignore export-ignore
.gitattributes export-ignore
# The manifest holds each fixture's SHA-256, so a checkout must not convert line
# endings. linguist-generated folds the captured files in GitHub diffs.
/storybook/fixtures/** -text linguist-generated

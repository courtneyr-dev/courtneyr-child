{
  "name": "courtneyr-child",
  "private": true,
  "description": "Lint, schema and local evidence tooling for the courtneyr-child theme. The theme source stays unminified; tools/minify-css.mjs minifies its CSS when the deploy repo syncs it.",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "lint": "npm run lint:php && npm run lint:css && npm run lint:theme-json && npm run lint:dark-tokens && npm run lint:preg",
    "lint:php": "node tests/lint/baseline.mjs phpcs",
    "lint:php:baseline": "node tests/lint/baseline.mjs phpcs --update",
    "lint:css": "node tests/lint/baseline.mjs stylelint",
    "lint:css:baseline": "node tests/lint/baseline.mjs stylelint --update",
    "lint:theme-json": "node tests/lint/theme-json-schema.mjs",
    "lint:dark-tokens": "node tests/lint/dark-tokens-parity.mjs",
    "build:css:check": "node tools/minify-css.mjs --dir assets/css --check",
    "lint:css-guardrails": "node tools/css-guardrails.mjs",
    "lint:preg": "node tests/lint/preg-ratchet.mjs",
    "lint:preg:baseline": "node tests/lint/preg-ratchet.mjs --update",
    "evidence": "node tests/evidence/evidence.mjs",
    "captures": "playwright test --config tests/playwright/playwright.config.mjs",
    "test:a11y-markup": "CR_SPEC=a11y-markup.spec.mjs playwright test --config tests/playwright/playwright.config.mjs --project=1280-light"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@wordpress/stylelint-config": "27.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "stylelint": "17.16.0",
    "stylelint-scss": "7.5.0"
  }
}

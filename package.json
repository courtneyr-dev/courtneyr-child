{
	"name": "courtneyr-child",
	"private": true,
	"description": "Lint, schema and local evidence tooling for the courtneyr-child theme. The theme has no build step.",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=20.19"
	},
	"scripts": {
		"lint": "npm run lint:php && npm run lint:css && npm run lint:theme-json",
		"lint:php": "node tests/lint/baseline.mjs phpcs",
		"lint:php:baseline": "node tests/lint/baseline.mjs phpcs --update",
		"lint:css": "node tests/lint/baseline.mjs stylelint",
		"lint:css:baseline": "node tests/lint/baseline.mjs stylelint --update",
		"lint:theme-json": "node tests/lint/theme-json-schema.mjs",
		"evidence": "node tests/evidence/evidence.mjs",
		"captures": "playwright test --config tests/playwright/playwright.config.mjs"
	},
	"devDependencies": {
		"@playwright/test": "1.62.1",
		"@wordpress/stylelint-config": "23.42.0",
		"ajv": "8.20.0",
		"ajv-formats": "2.1.1",
		"axe-core": "4.13.0",
		"stylelint": "16.26.1",
		"stylelint-scss": "6.14.0"
	}
}
